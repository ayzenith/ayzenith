# ─────────────────────────────────────────────────────────────────────────────
# AYZENITH — Environment
# Copy to .env.local for development; set the real values in the Vercel
# dashboard for production. Every variable is OPTIONAL: the site builds and runs
# with none of them set. Presence is what activates a capability.
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin — canonical URLs, sitemap, robots, Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.ayzenith.com

# ── Analytics (prepared, off by default — set an id to activate) ─────────────
# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=
# Microsoft Clarity project id
NEXT_PUBLIC_CLARITY_ID=
# Google Search Console HTML-tag verification token (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Contact delivery (prepared, acknowledge-only until configured) ───────────
# Delivery provider: "resend" | "none" (default: none → validated & acknowledged)
CONTACT_DELIVERY=none
# Destination inbox for partnership inquiries
CONTACT_TO_EMAIL=partnerships@ayzenith.com
# Verified "from" sender for transactional email
CONTACT_FROM_EMAIL=website@ayzenith.com
# Resend API key (server-only secret; used when CONTACT_DELIVERY=resend)
RESEND_API_KEY=

# ── SMTP / CRM (future integration seams — see lib/contact/delivery.ts) ───────
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# CRM_WEBHOOK_URL=
