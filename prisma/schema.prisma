// AYZENITH — Enterprise CMS data model.
//
// The schema is the single source of truth for the CMS. It is built up batch by
// batch; this first batch establishes the authentication + auditing core. Later
// batches add Product, Media, Content, Blog, Category, Service, SiteSetting and
// Revision models — each as an additive migration, so the UI layer never has to
// be rewritten (the "repository pattern" boundary lives in src/server/*).
//
// Target: Supabase Postgres. `url` is the pooled (pgBouncer) connection used at
// runtime; `directUrl` is the direct, non-pooled connection migrations need
// (pgBouncer can't run the DDL migrations issue).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Access levels. There is NO public registration — users are created only by a
/// Super Admin from inside the CMS.
enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

/// Publication state for a product.
///   DRAFT     — work in progress, never public
///   PUBLISHED — live on the public site
///   HIDDEN    — kept in the CMS but pulled from the public site (soft delete)
enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

/// A catalogue product. This is the DB source of truth that replaces the former
/// hardcoded `productData` array — the public site reads it through the
/// repository in src/server/products.ts, so anything an editor publishes here
/// appears on the site immediately.
///
/// Localized / structured fields (shortDescription, description, features,
/// useCases, specs, marketplaces, gallery, downloads) are stored as JSON so the
/// exact `Product` shape the UI already expects is preserved without a wide,
/// brittle relational spread. The repository is the only place that reads/writes
/// these shapes, keeping them typed at the boundary.
model Product {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  categoryKey  String
  status       ProductStatus @default(DRAFT)
  featured     Boolean       @default(false)
  availability String        @default("in-stock")
  badge        String? // "new" | "bestseller" | "featured" | null
  image        String? // primary image path/URL, or null → on-brand placeholder
  sortOrder    Int           @default(0)

  gallery          Json @default("[]") // string[]
  shortDescription Json // Localized<string>  { en, tr, de }
  description      Json // Localized<string>
  features         Json @default("{}") // Localized<string[]>
  useCases         Json @default("{}") // Localized<string[]>
  specs            Json @default("[]") // ProductSpec[]
  marketplaces     Json @default("{}") // Partial<Record<MarketplaceId, string>>
  downloads        Json @default("[]") // ProductDownload[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sortOrder])
}

/// A CMS operator. Passwords are stored only as bcrypt hashes.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activityLogs ActivityLog[]
  mediaAssets  MediaAsset[]

  @@index([role])
}

/// A per-string content override for the public site's copy. `key` is the
/// next-intl message dot-path (e.g. "hero.title"); en/tr/de hold the overridden
/// text for each language (null = keep the compiled default from messages/*.json).
/// These are merged over the base catalog in src/i18n/request.ts, so editing one
/// here updates every place that string appears — with zero component changes.
model ContentOverride {
  key       String   @id
  en        String?
  tr        String?
  de        String?
  updatedAt DateTime @updatedAt
}

/// Per-image overrides for the semantic media registry (src/config/assets.ts).
/// `key` is an AssetKey (e.g. "about.operations"); `url` points at a Media
/// Library asset. Resolved in the <Media> component, so setting one here swaps
/// the on-brand placeholder for real photography with zero component changes.
/// No row = the compiled placeholder/default is used.
model AssetOverride {
  key       String   @id
  url       String
  updatedAt DateTime @updatedAt
}

/// Editable site-wide settings — a single row (id = "site"). Every field is
/// nullable; a null falls back to the compiled default in src/config/site.ts /
/// env, so an empty table means "use the current defaults" and nothing changes
/// until the owner overrides a value in the CMS. Kept deliberately small and
/// content-only (no design), so editing it never affects the site's appearance.
model SiteSetting {
  id              String   @id @default("site")
  companyEmail    String?
  companyPhone    String?
  companyLocation String?
  hoursShort      String?
  hoursLong       String?
  linkedin        String?
  instagram       String?
  x               String?
  youtube         String?
  facebook        String?
  ga4Id           String?
  clarityId       String?
  updatedAt       DateTime @updatedAt
}

/// Triage state for an inbound contact/partnership inquiry.
enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

/// A submission from the public contact form. Persisted here so the owner has a
/// durable inbox in the CMS regardless of whether email delivery is configured.
/// The public form/route contract is unchanged — this is purely additive.
model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  company   String
  email     String
  region    String
  interest  String
  message   String
  status    ContactStatus @default(NEW)
  notes     String? // internal triage notes (never shown publicly)
  createdAt DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
}

/// An uploaded image in the Media Library. The binary lives in Supabase Storage
/// (public "media" bucket); this row is the searchable metadata + display name.
/// `path` is the immutable storage key; `name` is the editable label. Deleting a
/// row also removes the object from storage (handled in the repository).
model MediaAsset {
  id           String   @id @default(cuid())
  path         String   @unique // storage object key, e.g. "uploads/clx….webp"
  url          String // public URL for <Image src>
  name         String // editable display name (rename never touches storage)
  mime         String
  size         Int // bytes
  width        Int?
  height       Int?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Append-only audit trail. Powers the dashboard "Recent Activity" widget and
/// the per-user activity logs. `userId` is nullable + SetNull so history
/// survives a user being deleted.
model ActivityLog {
  id       String  @id @default(cuid())
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action   String // machine key, e.g. "user.login", "product.create"
  entity   String? // e.g. "product", "blogPost"
  entityId String?
  summary  String? // human-readable, e.g. "Signed in"

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// ============================================================================
// AYZENITH RADAR — internal market-intelligence system.
//
// A self-contained decision-support tool living beside the CMS. It turns a
// (category + market) input into a DETERMINISTIC opportunity score computed
// purely in code from official trade data (UN Comtrade / Eurostat / WITS).
// The AI layer only ever *explains* sourced data — it never invents a score,
// a trade figure, or an HS code. Every numeric claim carries a citation, and
// every analysis is frozen as an immutable snapshot so change-over-time is
// comparable. Strict layering: DATA → SCORING → SNAPSHOT → AI → UI, enforced
// by the repository boundary in src/server/radar/*.
// ============================================================================

/// Whether an HS mapping has been verified against an official source or still
/// needs a human to confirm it. Unverified codes are NEVER used in analysis.
enum RadarHsVerification {
  VERIFIED // confirmed against an official HS/Comtrade source
  NEEDS_REVIEW // AI-suggested or uncertain — excluded from scoring until confirmed
}

/// The decision band a final score falls into. Thresholds are configurable in
/// RadarSetting; INSUFFICIENT_DATA is a first-class outcome (the system is
/// allowed to say "I don't know" rather than fabricate a score).
enum RadarDecision {
  WORTH_RESEARCHING // default band ≥ 80
  MONITOR // 60–79
  NOT_PRIORITY // 0–59
  INSUFFICIENT_DATA // critical data (import volume) missing → no score produced
}

/// Curated category → HS-6 mapping. This is the human-owned bridge between the
/// owner's commercial vocabulary ("Tüketici Elektroniği") and the HS-6 codes
/// the trade APIs actually speak. Codes are verified against official sources,
/// never AI-generated. A single HS-6 code MAY belong to multiple categories
/// (composite key on categoryKey+hs6 allows the overlap on purpose), so e.g.
/// "851830 Headphones" can sit under both Consumer Electronics and Mobile
/// Accessories. Editable in Admin → Radar → HS Eşlemeleri.
model RadarHsMapping {
  id           String              @id @default(cuid())
  categoryKey  String // e.g. "consumer-electronics"
  hs6          String // 6-digit HS code, e.g. "851830"
  productGroup String // plain-language product group this code represents
  verification RadarHsVerification @default(NEEDS_REVIEW)
  source       String? // where the code was verified (e.g. "UN Comtrade HS 2022")
  verifiedAt   DateTime? // when a human confirmed it
  note         String?
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([categoryKey, hs6])
  @@index([categoryKey])
  @@index([hs6])
}

/// Raw API response cache. Comtrade in particular is rate-limited, so identical
/// queries must never be re-fetched while fresh. `key` is a deterministic hash
/// of (provider + normalized query). `payload` holds the raw provider response
/// verbatim (so citations can always point back to exactly what was fetched);
/// `expiresAt` is derived from the configurable cache TTL. A miss or an expired
/// row triggers a real fetch; a provider outage is surfaced, never masked.
model RadarRawCache {
  key       String   @id // hash(provider + query)
  provider  String // "comtrade" | "eurostat" | "wits"
  query     Json // normalized query params, for transparency/citations
  payload   Json // raw provider response
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([provider])
  @@index([expiresAt])
}

/// An immutable analysis result. Once written it is NEVER updated — a re-run
/// produces a new row. It freezes EVERYTHING needed to reproduce and compare:
/// the input, the resolved HS codes, every raw datum used, the five criterion
/// scores, the final score + decision, the exact weights in force at that time
/// (so changing weights later never rewrites history), the data-confidence, and
/// the AI interpretation text. Sub-category (HS-6) breakdown scores are stored
/// too. `watchId` links snapshots produced by a tracked market.
model RadarSnapshot {
  id           String @id @default(cuid())
  categoryKey  String
  geoScope     String // "country" | "region"
  countryCode  String // ISO code, or the region key when geoScope = region
  countryLabel String // display label at time of analysis
  supplyMarket String @default("TR")
  tradeModel   String @default("B2B")

  // V1.1 — analysis scope. "category" analyses the whole verified HS set for a
  // category (the original behaviour); "product" analyses ONE confirmed HS-6.
  // Additive + backward compatible: existing snapshots default to "category" and
  // keep productName/hsCode null — their frozen scores are never recomputed.
  analysisType String  @default("category") // "category" | "product"
  productName  String? // natural-language product name (product scope only)
  hsCode       String? // the single HS-6 analysed (product scope only)

  resolvedHs       Json // [{ hs6, productGroup }] actually used
  criteria         Json // [{ key, score, weight, rawInputs, explanation }]
  finalScore       Int? // null when decision = INSUFFICIENT_DATA
  decision         RadarDecision
  weightsUsed      Json // { demand, growth, supplyAdvantage, entry, competition }
  confidence       Int // 0–100, share of criteria backed by real data
  measuredCriteria Int // how many of the 5 criteria had data
  subCategories    Json          @default("[]") // [{ hs6, productGroup, score, trendPct }]
  aiSummary        String? // AI interpretation (sourced-data-only); null until generated

  watchId   String?
  watch     RadarWatch?     @relation(fields: [watchId], references: [id], onDelete: SetNull)
  citations RadarCitation[]

  createdAt DateTime @default(now())

  @@index([categoryKey, countryCode])
  @@index([watchId])
  @@index([createdAt])
}

/// A source record for one numeric datum used in a snapshot. This is the spine
/// of the "no unsourced number is ever shown as verified" rule: every 🟢 figure
/// in the UI maps to one of these. It stores the provider, the exact query, the
/// raw value + unit, the source URL and when it was fetched — enough to click
/// through and audit.
model RadarCitation {
  id         String        @id @default(cuid())
  snapshotId String
  snapshot   RadarSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  provider  String // "comtrade" | "eurostat" | "wits"
  label     String // human label, e.g. "Almanya elektronik ithalatı 2024"
  query     Json // exact query used
  rawValue  String // raw value as returned (kept as string to avoid precision loss)
  unit      String? // "USD" | "%" | ...
  sourceUrl String? // deep link back to the source when available
  fetchedAt DateTime

  @@index([snapshotId])
}

/// A tracked market. When active, the system re-fetches on a schedule (weekly)
/// and on demand ("Şimdi Yenile"), producing a fresh snapshot each time and
/// comparing it to the previous one. `lastScore`/`lastSnapshotId` cache the most
/// recent result for the dashboard; the full history lives in RadarSnapshot.
model RadarWatch {
  id              String    @id @default(cuid())
  categoryKey     String
  countryCode     String
  label           String // display label, e.g. "Almanya · Tüketici Elektroniği"
  active          Boolean   @default(true)
  lastScore       Int?
  lastSnapshotId  String?
  lastRefreshedAt DateTime?
  createdAt       DateTime  @default(now())

  snapshots RadarSnapshot[]

  @@unique([categoryKey, countryCode])
  @@index([active])
}

/// Single-row (id = "radar") configuration for the scoring engine and pipeline.
/// Every knob the owner is allowed to turn lives here; all fields are nullable
/// and fall back to the compiled defaults in src/config/radar.ts, so an empty
/// table means "use the defaults". Weights/thresholds changes affect only FUTURE
/// analyses — existing snapshots keep the weights they were frozen with.
model RadarSetting {
  id                  String   @id @default("radar")
  weights             Json? // { demand, growth, supplyAdvantage, entry, competition } summing to 100
  thresholds          Json? // { worth: 80, monitor: 60 }
  certificationBurden Json? // { categoryKey: "low"|"medium"|"high"|"very-high" }
  regions             Json? // { "europe": ["DE","NL",...] }
  cacheTtlDays        Int? // how long raw data stays fresh (default 30)
  alertThreshold      Int? // score delta that raises a watch alert (default 5)
  updatedAt           DateTime @updatedAt
}

// ============================================================================
// AYZENITH LEAD FINDER — internal commercial lead-discovery system.
//
// An independent module that sits BESIDE RADAR (it does not modify it). RADAR
// answers "is this market worth entering?"; Lead Finder answers "who do we sell
// to there?". It turns a (country + product + business model) input into a pool
// of DISCOVERED candidates, then VERIFIES, CLASSIFIES, SCORES and PRIORITISES
// them — all from FREE, public sources (OpenStreetMap, official company sites),
// with a $0 mandatory API cost. It reuses RADAR's honesty spine verbatim:
//   • Discovery and verification are SEPARATE phases (a discovered row is never
//     an automatic qualified lead).
//   • Every important datum carries its source + lastCheckedAt; nothing is ever
//     fabricated — missing data is shown as missing, never guessed.
//   • The AI layer (optional) only ever phrases/suggests over sourced data.
//   • It shares RADAR's raw-response cache (RadarRawCache) so the two tools grow
//     into one AYZENITH data engine.
// Strict layering: DISCOVERY → DEDUP → QUALIFY → SCORE → CONTACT → EXPORT,
// enforced by the repository boundary in src/server/leads/*.
// ============================================================================

/// The lifecycle state of a candidate. DISCOVERED is the raw pool; a row is only
/// promoted to QUALIFIED/HIGH_PRIORITY after verification. Missing-data and
/// duplicate outcomes are first-class (the system may say "I don't know" or
/// "already have this"), never silently dropped. CRM-forward stages
/// (CONTACTED…WON/LOST) exist so an exported lead maps cleanly into a future CRM;
/// V1 only writes the discovery→priority range.
enum LeadStatus {
  DISCOVERED
  SCREENING
  QUALIFIED
  HIGH_PRIORITY
  REJECTED
  DUPLICATE
  INACTIVE
  INSUFFICIENT_DATA
  // CRM-forward (reserved for later batches; not written in V1 discovery)
  CONTACTED
  REPLIED
  MEETING
  QUOTATION
  NEGOTIATION
  WON
  LOST
}

/// Company/store size, derived ONLY from verifiable signals (branch count,
/// employee count, public profile). UNKNOWN is the honest default — the system
/// never guesses a size to fill the field.
enum LeadSize {
  LARGE
  MEDIUM
  SMALL
  MICRO
  ONLINE
  UNKNOWN
}

/// Whether the candidate is actually connected to the searched product. VERIFIED
/// requires evidence on a source (category page, catalogue, profile); otherwise
/// UNCLEAR/UNVERIFIED. A strong lead is never shown without a VERIFIED fit.
enum LeadProductFit {
  VERIFIED
  LIKELY
  UNCLEAR
  NOT_RELEVANT
  UNVERIFIED
}

/// Strength of a real commercial-activity signal. NONE = no signal found (which
/// is NOT a negative signal — absence of data is never read as a bad datum).
enum LeadSignalStrength {
  STRONG
  MEDIUM
  WEAK
  NONE
}

/// Data freshness for a company/contact, from lastCheckedAt vs the re-check TTL.
enum LeadFreshness {
  FRESH // 🟢 recently verified
  RECHECK // 🟡 re-verification recommended
  STALE // 🔴 old / could not be re-verified
}

/// Where a datum came from. Kept coarse + stable so provenance is comparable and
/// the module can add PAID_* source types later without a schema change.
enum LeadSourceType {
  OSM // OpenStreetMap / Overpass
  OFFICIAL_WEBSITE // the company's own site (incl. Impressum)
  PUBLIC_WEB // other public web page
  PUBLIC_BUSINESS_DIRECTORY // open business directory
  RADAR // carried over from a RADAR analysis (context linkage)
  MANUAL // entered/curated by an operator
  OTHER_FREE_SOURCE
}

/// One search run — the commercial question asked. Freezes the full context
/// (country/city/product/model/lead types) so results are always interpretable,
/// and preserves the RADAR linkage (§2): a lead found via RADAR keeps a pointer
/// back to the snapshot + the band that motivated it. Independent runs simply
/// leave the radar* fields null (§3).
model LeadSearch {
  id            String  @id @default(cuid())
  country       String // ISO alpha-2 (target market)
  countryLabel  String // display label at run time
  city          String? // optional city focus
  productQuery  String // natural-language product, e.g. "kadın iç giyim"
  businessModel String  @default("B2B") // "B2B" | "B2C" (kept a string, mirrors RADAR)
  leadTypes     Json    @default("[]") // string[] of LeadRole keys, [] = all
  searchTerms   Json    @default("[]") // the multilingual terms actually used (audit)

  // RADAR linkage (§2) — null for a standalone run (§3).
  radarSnapshotId String?
  categoryKey     String? // carried from RADAR when opened from an analysis
  hs6             String? // carried HS-6 (context only; never treated as verified here)
  radarScore      Int? // the RADAR score that motivated this search (context)
  radarDecision   String? // the RADAR band label (context)

  status          LeadStatus @default(DISCOVERED)
  totalDiscovered Int        @default(0)
  // Discovery reliability (V2 fix): whether the free source(s) actually answered.
  // "OK" = source responded; "PARTIAL" = some queries failed; "FAILED" = the
  // source could not be reached — so a 0 result is NOT a "no leads" verdict.
  discoveryStatus String     @default("OK")
  sourceStats     Json       @default("{}") // { osm: { status, queriesRun, queriesOk, queriesFailed, rawResults } }
  errors          Json       @default("[]") // string[] — provider outages, surfaced never masked
  createdById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  companies LeadCompany[]
  exports   LeadExport[]

  @@index([country])
  @@index([createdAt])
  @@index([radarSnapshotId])
}

/// A discovered company or physical store. This is the heart of the module. A row
/// starts life as a DISCOVERED candidate and only earns a score/priority after
/// verification. `commercialRoles` is an array on purpose (§9): one firm may be
/// importer + distributor + wholesaler + e-commerce at once. Size/productFit have
/// honest "unknown/unverified" defaults so an empty field never reads as a fact.
/// Dedup keys (domain, name+city) are indexed so the same firm is not stored
/// twice across searches (§13).
model LeadCompany {
  id       String      @id @default(cuid())
  searchId String?
  search   LeadSearch? @relation(fields: [searchId], references: [id], onDelete: SetNull)

  name      String
  legalName String? // e.g. "ABC Handels GmbH" from an Impressum (verified only)
  domain    String? // normalised registrable domain — the primary dedup key
  website   String?
  phone     String?
  email     String?

  country    String
  city       String?
  address    String?
  postalCode String?
  latitude   Float?
  longitude  Float?

  businessModel   String         @default("B2B")
  commercialRoles Json           @default("[]") // LeadRole[] (array — multi-role)
  size            LeadSize       @default(UNKNOWN)
  sizeSignals     Json           @default("[]") // [{ label, value, source }] used for size (or [])
  productFit      LeadProductFit @default(UNVERIFIED)
  productFitNote  String? // short, sourced reason — never an AI guess presented as fact

  // V2 — website intelligence (all additive + nullable; a null means "not
  // determined", never a negative fact). Populated by the verification stage.
  detectedModel     String? // "B2B" | "B2C" | "BOTH" — detected from the site, not the search
  websiteStatus     String? // "ACTIVE" | "UNREACHABLE" | "NONE"
  productCategories Json      @default("[]") // string[] of categories evidenced on the site
  storeCount        Int? // physical stores/branches, only if the site stated it
  employeeCount     Int? // only if the company publicly stated it
  matchStatus       String? // "UNCERTAIN_MATCH" when dedup was ambiguous (§14)
  verifiedAt        DateTime? // when website verification last ran (distinct from discovery)

  // V2.1 — qualification (§1–§9). All additive/nullable.
  modelFit         String? // ModelFit for the searched model: VERIFIED|POSSIBLE|NOT_SUITABLE|UNVERIFIED
  modelFitEvidence Json    @default("[]") // string[] — why (roles/site signals)
  productFitTier   String? // "STRONG" | "MEDIUM" | "WEAK"
  canonicalName    String? // normalised brand/name used for company-identity dedup
  locationCount    Int     @default(1) // distinct branches merged under this company (§4)

  // V2.1 — social intelligence (§13–§29). Sourced from the company's OWN website.
  instagramUrl         String?
  facebookUrl          String?
  linkedinUrl          String?
  tiktokUrl            String?
  youtubeUrl           String?
  xUrl                 String?
  socialMatchStatus    String? // "VERIFIED" (link on own site) | "POSSIBLE" | "UNVERIFIED"
  socialProductSignal  String? // "STRONG" | "WEAK" | null — from social handle/url only
  socialBusinessSignal String? // "B2B" | "B2C" | null — from social handle/url only
  socialVerifiedAt     DateTime?

  leadScore      Int? // deterministic 0–100; null until scored / when insufficient
  leadConfidence Int? // 0–100, how verified the underlying data is (≠ score, §15)
  scoreBreakdown Json @default("{}") // { components: [{ key, weight, score, available }], ... }

  status    LeadStatus    @default(DISCOVERED)
  freshness LeadFreshness @default(FRESH)

  // RADAR context carried onto the lead itself (so a card can show "why found").
  radarSnapshotId String?

  discoveredVia LeadSourceType @default(OSM)
  discoveredAt  DateTime       @default(now())
  lastCheckedAt DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  contacts      LeadContact[]
  sources       LeadSource[]
  signals       LeadSignal[]
  verifications LeadVerification[]
  locations     LeadLocation[]

  @@index([searchId])
  @@index([country, city])
  @@index([domain])
  @@index([status])
  @@index([leadScore])
}

/// A decision-maker / professional contact at a company (§17). Only public,
/// professional information is stored (corporate email, public role, profile).
/// `roleVerified` gates whether the role is shown as fact or as "doğrulanamadı" —
/// a role is never inferred and presented as certain. Personal/private data is
/// out of scope by design (§18). Populated in a later batch; the relation exists
/// now so the data model is CRM-ready.
model LeadContact {
  id        String      @id @default(cuid())
  companyId String
  company   LeadCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  firstName      String?
  lastName       String?
  role           String? // e.g. "Purchasing Manager" — shown as fact only if verified
  roleVerified   Boolean @default(false)
  corporateEmail String?
  profileUrl     String? // public professional profile (e.g. LinkedIn)
  confidence     Int     @default(0) // 0–100 deterministic

  source        LeadSourceType @default(OFFICIAL_WEBSITE)
  sourceUrl     String?
  lastCheckedAt DateTime       @default(now())
  createdAt     DateTime       @default(now())

  @@index([companyId])
}

/// A physical branch/location of a company (§4/§9). A retail chain with several
/// stores in one city is ONE LeadCompany with several LeadLocation rows — never
/// duplicated as separate company leads. Additive: companies without branch data
/// simply have zero location rows and locationCount defaults to 1.
model LeadLocation {
  id        String      @id @default(cuid())
  companyId String
  company   LeadCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name       String?
  address    String?
  city       String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  phone      String?
  sourceType LeadSourceType @default(OSM)
  sourceUrl  String?
  createdAt  DateTime       @default(now())

  @@index([companyId])
}

/// Provenance for one field of a company (§19). This is the spine of "no unsourced
/// datum is shown as verified": every important value maps to one of these, with
/// the source, a deep link when available, and when it was collected/last checked.
model LeadSource {
  id        String      @id @default(cuid())
  companyId String
  company   LeadCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  dataField     String // which field this backs, e.g. "address", "website", "productFit"
  sourceType    LeadSourceType
  label         String? // human label, e.g. "OpenStreetMap — Berlin"
  sourceUrl     String?
  collectedAt   DateTime       @default(now())
  lastCheckedAt DateTime       @default(now())

  @@index([companyId])
}

/// A real commercial-activity signal (§16), e.g. "active product category",
/// "new market expansion". Strength is a controlled band, never "is buying now".
/// Absence of signals is NONE — never read as a negative. Populated from later
/// batches; the relation exists now.
model LeadSignal {
  id        String      @id @default(cuid())
  companyId String
  company   LeadCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind       String // e.g. "category-active", "sourcing", "expansion"
  strength   LeadSignalStrength @default(NONE)
  note       String?
  sourceType LeadSourceType     @default(PUBLIC_WEB)
  sourceUrl  String?
  detectedAt DateTime           @default(now())

  @@index([companyId])
}

/// One verification check result (§10) — the audit trail of qualification. Each
/// of the honesty checks (real business? in target country? website present?
/// product connection? role verifiable? contact present? address verifiable?
/// active store/site?) is a row, with the evidence and where it came from. This
/// is what makes discovery→qualification a transparent, reviewable step.
model LeadVerification {
  id        String      @id @default(cuid())
  companyId String
  company   LeadCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  check     String // machine key, e.g. "is-real-business", "in-target-country"
  passed    Boolean? // null = could not be determined (honest "unknown")
  evidence  String? // short sourced note
  sourceUrl String?
  checkedAt DateTime @default(now())

  @@index([companyId])
}

/// An export event (§27/§28) — a durable record of what was exported, with the
/// exact filters in force, so an export is reproducible and auditable.
model LeadExport {
  id       String      @id @default(cuid())
  searchId String?
  search   LeadSearch? @relation(fields: [searchId], references: [id], onDelete: SetNull)

  format      String // "xlsx" | "csv"
  filterJson  Json     @default("{}") // the active filter set applied
  rowCount    Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([searchId])
  @@index([createdAt])
}

/// Single-row (id = "lead") configuration for the Lead Finder scoring engine and
/// pipeline. Mirrors RadarSetting: every knob lives here, all fields nullable,
/// falling back to the compiled defaults in src/config/leads.ts. Weight changes
/// affect only FUTURE scoring (existing companies keep their frozen breakdown).
model LeadSetting {
  id          String   @id @default("lead")
  weights     Json? // { productFit, roleFit, activity, market, size, dataQuality } → 100
  thresholds  Json? // { strong: 80, potential: 60 }
  recheckDays Int? // when a lead becomes "re-verify recommended" (default 30)
  updatedAt   DateTime @updatedAt
}

// =============================================================================
// AYZENITH BUSINESS OS — V1
// =============================================================================
//
// Everything below this line is ADDITIVE. Not one existing model, column or
// index is touched: the CMS, RADAR and Lead Finder schemas are identical to what
// they were before this block existed, and dropping every table below would
// leave them untouched.
//
// Three rules govern this half of the schema:
//
//  1. MONEY IS `Decimal`, NEVER `Float`. Every monetary row also carries its own
//     `currency` + `fxRate` + `fxRateDate`, because a sale invoiced in EUR and a
//     cost paid in TRY can only be compared through the rate that applied on the
//     day each happened. One global rate applied retroactively makes every
//     margin in the system quietly wrong.
//
//  2. STOCK IS A LEDGER, NOT A NUMBER. There is no mutable `quantity` column on
//     a location. On-hand is the SUM of signed StockMovement rows, so every unit
//     can be traced to the document that moved it — the stock counterpart of the
//     "every figure has a source" rule RADAR and Lead Finder already follow.
//
//  3. LINKS TO LEAD FINDER / RADAR ARE PLAIN STRINGS, NOT FOREIGN KEYS. A re-run
//     of a lead search may rewrite or delete its own rows; a real FK from here
//     could block that or cascade into operational data. Business OS COPIES what
//     it needs and remembers where it came from. The coupling is one-way and
//     severable.
//
// Tax is RECORDED, never COMPUTED (see TaxRecord).
// =============================================================================

/// The hat a firm wears in a relationship. A firm may wear several at once —
/// that is the whole point of keeping roles in their own table instead of typing
/// the company itself. One `Party` row, many `PartyRelation` rows.
enum PartyRoleType {
  CUSTOMER
  SUPPLIER
  DEALER
  DISTRIBUTOR
  STORE
  PARTNER
  CARRIER
  SERVICE_PROVIDER
  OTHER
}

/// How business is actually done with that firm.
enum TradeModel {
  WHOLESALE
  RETAIL
  DROPSHIP
  CONSIGNMENT
  MARKETPLACE
  AGENCY
  OTHER
}

enum RelationStatus {
  PROSPECT
  ACTIVE
  PAUSED
  ENDED
}

enum ChannelType {
  MARKETPLACE
  OWN_WEBSITE
  PHYSICAL_STORE
  B2B
  DEALER
  DISTRIBUTOR
  MANUAL
  OTHER
}

enum StockLocationType {
  WAREHOUSE
  STORE
  CHANNEL
  CONSIGNMENT
  TRANSIT
  OTHER
}

/// Why stock moved. Every movement has one — an unexplained quantity change is
/// exactly the thing this ledger exists to make impossible.
enum StockMoveReason {
  OPENING
  PURCHASE
  SALE
  TRANSFER
  RETURN
  ADJUSTMENT
  DAMAGE
}

/// Document lifecycle. DRAFT has NO side effects: no stock, no payable, no
/// receivable. CONFIRMED posts them atomically. CANCELLED reverses them and
/// keeps the record — financial history is voided, never deleted.
enum DocStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  CHEQUE
  LETTER_OF_CREDIT
  PLATFORM
  OTHER
}

/// Direct costs that attach to a document and become part of landed cost.
enum CostKind {
  FREIGHT
  CUSTOMS
  COMMISSION
  PACKAGING
  INSURANCE
  BANK
  MARKETING
  OTHER
}

/// How a CostLine spreads over the lines of its document.
enum CostAllocation {
  BY_VALUE
  BY_QUANTITY
  NONE
}

/// Overheads — the costs that are NOT attached to one shipment.
enum ExpenseKind {
  RENT
  SALARY
  SOFTWARE
  UTILITIES
  ACCOUNTING
  MARKETING
  BANK
  LOGISTICS
  TRAVEL
  TAX
  OTHER
}

enum RecurrenceFreq {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum TaxStatus {
  PLANNED
  DUE
  PAID
  CANCELLED
}

// ---------------------------------------------------------------------------
// Firms and people
// ---------------------------------------------------------------------------

/// A firm — ONE row per real-world company, whatever it does for you.
///
/// This is deliberately NOT `LeadCompany`. That model is a discovery artefact:
/// scoped to a search, re-writable on a re-run, and semantically "an unverified
/// candidate". Putting an invoice against it would mean a search re-run could
/// silently overwrite a customer. `leadCompanyId` below records provenance for a
/// firm that ARRIVED from Lead Finder, as a plain string with no FK.
model Party {
  id        String  @id @default(cuid())
  name      String
  legalName String?

  taxNumber  String?
  taxOffice  String?
  country    String  @default("TR")
  city       String?
  address    String?
  postalCode String?

  website String?
  phone   String?
  email   String?

  /// The currency this firm is normally invoiced in — a default for new
  /// documents, never a constraint on them.
  currency        String  @default("TRY")
  paymentTermDays Int?
  notes           String?
  active          Boolean @default(true)

  /// One-way provenance from Lead Finder. Intentionally NOT a relation.
  leadCompanyId String?
  leadSearchId  String?
  importedAt    DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  relations         PartyRelation[]
  contacts          PartyContact[]
  purchases         Purchase[]
  sales             Sale[]
  payments          Payment[]
  channels          Channel[]
  stockLocations    StockLocation[]
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@index([name])
  @@index([country])
  @@index([active])
  @@index([leadCompanyId])
}

/// One commercial relationship with a firm. The unique key is (party, role), so
/// "ABC GmbH" can be CUSTOMER and SUPPLIER and DISTRIBUTOR at the same time
/// without ever being entered three times.
model PartyRelation {
  id      String @id @default(cuid())
  partyId String
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  role       PartyRoleType
  tradeModel TradeModel?
  status     RelationStatus @default(ACTIVE)
  startedAt  DateTime?
  endedAt    DateTime?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partyId, role])
  @@index([role])
  @@index([status])
}

/// An operational contact at a firm — the person you actually write to. Separate
/// from `LeadContact`, which is a sourced discovery record and may only contain
/// what a public page proved.
model PartyContact {
  id      String @id @default(cuid())
  partyId String
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String?
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partyId])
}

// ---------------------------------------------------------------------------
// Goods, channels, stock
// ---------------------------------------------------------------------------

/// A traded good. NOT the CMS `Product`, which is website content and carries no
/// cost, price, unit or stock. `cmsProductId` optionally points at the catalogue
/// entry that shows this SKU on the public site.
model Item {
  id      String  @id @default(cuid())
  sku     String  @unique
  name    String
  barcode String?

  category String?
  brand    String?
  unit     String  @default("adet")

  purchasePrice    Decimal? @db.Decimal(18, 4)
  purchaseCurrency String   @default("TRY")
  salePrice        Decimal? @db.Decimal(18, 4)
  saleCurrency     String   @default("TRY")
  /// Recorded for the document, not used to compute a tax liability.
  vatRate          Decimal? @db.Decimal(6, 3)

  minStock Decimal? @db.Decimal(18, 3)
  active   Boolean  @default(true)

  description String?
  notes       String?

  cmsProductId String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channelPrices ItemChannelPrice[]
  movements     StockMovement[]
  purchaseLines PurchaseLine[]
  saleLines     SaleLine[]

  @@index([name])
  @@index([category])
  @@index([active])
}

/// Where you sell. A channel may BE a firm (a dealer, a distributor), in which
/// case `partyId` points at it — still one Party row, wearing another hat.
model Channel {
  id   String      @id @default(cuid())
  name String      @unique
  type ChannelType @default(OTHER)

  /// Percent, e.g. 21.500 — recorded per channel and applied as a CostLine on
  /// the sale, so it lands in margin rather than hiding in the price.
  commissionRate Decimal? @db.Decimal(6, 3)
  currency       String   @default("TRY")

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)

  /// Reserved for a future marketplace integration (store id / seller id). Never
  /// read by V1 — it exists so adding an integration is not a migration.
  externalKey String?

  active Boolean @default(true)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices         ItemChannelPrice[]
  sales          Sale[]
  stockLocations StockLocation[]

  @@index([type])
  @@index([active])
}

/// The same SKU at a different price per channel — Trendyol TRY 1.499, own site
/// TRY 1.399, B2B TRY 1.100.
model ItemChannelPrice {
  id        String  @id @default(cuid())
  itemId    String
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  price    Decimal @db.Decimal(18, 4)
  currency String  @default("TRY")
  active   Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([itemId, channelId])
  @@index([channelId])
}

/// A place stock can sit: the main warehouse, a shop floor, a marketplace's
/// fulfilment centre, goods on consignment at a partner.
model StockLocation {
  id   String            @id @default(cuid())
  name String            @unique
  type StockLocationType @default(WAREHOUSE)

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  partyId   String?
  party     Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)

  country   String?
  city      String?
  isDefault Boolean @default(false)
  active    Boolean @default(true)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]
  purchases Purchase[]
  sales     Sale[]

  @@index([type])
  @@index([active])
}

/// One signed movement of one SKU in or out of one location. Positive = in,
/// negative = out; a transfer is TWO rows sharing a `transferGroup`. On-hand is
/// never stored — it is `SUM(quantity)`, which is why it can always be explained.
model StockMovement {
  id         String        @id @default(cuid())
  itemId     String
  item       Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId String
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  quantity Decimal         @db.Decimal(18, 3)
  reason   StockMoveReason

  /// Landed unit cost carried by this movement, in base currency. Populated for
  /// inbound movements; consumed by sales to value COGS.
  unitCost Decimal? @db.Decimal(18, 6)

  occurredAt DateTime @default(now())

  purchaseId    String?
  purchase      Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  saleId        String?
  sale          Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  transferGroup String?

  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([itemId, locationId])
  @@index([occurredAt])
  @@index([purchaseId])
  @@index([saleId])
  @@index([transferGroup])
}

// ---------------------------------------------------------------------------
// Buying
// ---------------------------------------------------------------------------

/// A purchase from a supplier. Confirming it posts stock in, spreads its cost
/// lines over the goods, and creates the payable.
model Purchase {
  id         String @id @default(cuid())
  code       String @unique
  supplierId String
  supplier   Party  @relation(fields: [supplierId], references: [id])

  locationId String?
  location   StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  issuedAt        DateTime  @default(now())
  dueDate         DateTime?
  paymentTermDays Int?

  currency   String    @default("TRY")
  /// Units of BASE currency per 1 unit of `currency`, on `fxRateDate`. Frozen at
  /// the document — never recomputed from a later rate.
  fxRate     Decimal   @default(1) @db.Decimal(18, 8)
  fxRateDate DateTime?

  status DocStatus @default(DRAFT)

  /// All three are derived from the lines and cost lines, in document currency.
  subtotal  Decimal @default(0) @db.Decimal(18, 4)
  costTotal Decimal @default(0) @db.Decimal(18, 4)
  total     Decimal @default(0) @db.Decimal(18, 4)

  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines     PurchaseLine[]
  costs     CostLine[]
  payments  Payment[]
  movements StockMovement[]

  @@index([supplierId])
  @@index([issuedAt])
  @@index([status])
}

model PurchaseLine {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])

  quantity     Decimal @db.Decimal(18, 3)
  unitPrice    Decimal @db.Decimal(18, 4)
  discountRate Decimal @default(0) @db.Decimal(6, 3)
  vatRate      Decimal @default(0) @db.Decimal(6, 3)
  lineTotal    Decimal @default(0) @db.Decimal(18, 4)

  /// Landed unit cost in BASE currency: goods + the line's share of freight,
  /// customs and other cost lines. DERIVED on confirm — never typed by hand,
  /// which is what stops two different "real cost" numbers existing at once.
  landedUnitCost Decimal? @db.Decimal(18, 6)

  note String?

  @@index([purchaseId])
  @@index([itemId])
}

// ---------------------------------------------------------------------------
// Selling
// ---------------------------------------------------------------------------

/// A sale to a customer, through a channel. Confirming it posts stock out at the
/// weighted-average landed cost, applies the channel commission as a cost line,
/// and creates the receivable.
model Sale {
  id         String  @id @default(cuid())
  code       String  @unique
  customerId String?
  customer   Party?  @relation(fields: [customerId], references: [id])

  channelId  String?
  channel    Channel?       @relation(fields: [channelId], references: [id], onDelete: SetNull)
  locationId String?
  location   StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  issuedAt        DateTime  @default(now())
  dueDate         DateTime?
  paymentTermDays Int?

  currency   String    @default("TRY")
  fxRate     Decimal   @default(1) @db.Decimal(18, 8)
  fxRateDate DateTime?

  status     DocStatus   @default(DRAFT)
  /// DROPSHIP marks a sale that must NOT draw down own stock — the goods are
  /// shipped by the supplier. Stock posting is skipped for these.
  tradeModel TradeModel?

  subtotal  Decimal @default(0) @db.Decimal(18, 4)
  costTotal Decimal @default(0) @db.Decimal(18, 4)
  total     Decimal @default(0) @db.Decimal(18, 4)
  /// Cost of goods and gross profit, in BASE currency — derived on confirm.
  cogsTotal Decimal @default(0) @db.Decimal(18, 4)
  profit    Decimal @default(0) @db.Decimal(18, 4)

  /// Which market analysis this sale came out of. Plain string by design.
  radarSnapshotId String?

  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines     SaleLine[]
  costs     CostLine[]
  payments  Payment[]
  movements StockMovement[]
  documents TradeDocument[]

  @@index([customerId])
  @@index([channelId])
  @@index([issuedAt])
  @@index([status])
}

model SaleLine {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  quantity     Decimal @db.Decimal(18, 3)
  unitPrice    Decimal @db.Decimal(18, 4)
  discountRate Decimal @default(0) @db.Decimal(6, 3)
  vatRate      Decimal @default(0) @db.Decimal(6, 3)
  lineTotal    Decimal @default(0) @db.Decimal(18, 4)

  /// Snapshot of landed unit cost at the moment of sale, in BASE currency.
  unitCost  Decimal? @db.Decimal(18, 6)
  costTotal Decimal  @default(0) @db.Decimal(18, 4)
  profit    Decimal  @default(0) @db.Decimal(18, 4)

  note String?

  documentLines TradeDocumentLine[]

  @@index([saleId])
  @@index([itemId])
}

/// A direct cost attached to one document: freight, customs, marketplace
/// commission, packaging. Carries its own currency and rate because freight is
/// routinely paid in a different money from the goods.
model CostLine {
  id    String   @id @default(cuid())
  kind  CostKind @default(OTHER)
  label String?

  amount     Decimal        @db.Decimal(18, 4)
  currency   String         @default("TRY")
  fxRate     Decimal        @default(1) @db.Decimal(18, 8)
  fxRateDate DateTime?
  allocation CostAllocation @default(BY_VALUE)

  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  saleId     String?
  sale       Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  occurredAt DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())

  @@index([purchaseId])
  @@index([saleId])
}

// ---------------------------------------------------------------------------
// Money in, money out
// ---------------------------------------------------------------------------

/// One expected or settled movement of money. Direction IN is a receivable, OUT
/// a payable. Several rows against the same document ARE the instalment plan, so
/// no separate schedule model is needed. This one table drives the whole
/// 30-day / 1-6 / 6-12 / 12+ finance calendar.
model Payment {
  id        String           @id @default(cuid())
  direction PaymentDirection

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)

  purchaseId  String?
  purchase    Purchase?  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  saleId      String?
  sale        Sale?      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  expenseId   String?
  expense     Expense?   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  taxRecordId String?
  taxRecord   TaxRecord? @relation(fields: [taxRecordId], references: [id], onDelete: Cascade)

  amount     Decimal   @db.Decimal(18, 4)
  paidAmount Decimal   @default(0) @db.Decimal(18, 4)
  currency   String    @default("TRY")
  fxRate     Decimal   @default(1) @db.Decimal(18, 8)
  fxRateDate DateTime?

  dueDate DateTime
  paidAt  DateTime?

  /// PENDING/PARTIAL/PAID/CANCELLED only. "Overdue" is NOT stored — it is
  /// `dueDate < today AND status <> PAID`, so it can never go stale.
  status PaymentStatus  @default(PENDING)
  method PaymentMethod?

  reference String?
  note      String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([direction, status, dueDate])
  @@index([dueDate])
  @@index([partyId])
  @@index([purchaseId])
  @@index([saleId])
}

/// An overhead — rent, salary, software, accountancy. Not attached to a shipment
/// (those are CostLine). Creating one creates its OUT payment.
model Expense {
  id    String      @id @default(cuid())
  title String
  kind  ExpenseKind @default(OTHER)

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)

  amount     Decimal   @db.Decimal(18, 4)
  currency   String    @default("TRY")
  fxRate     Decimal   @default(1) @db.Decimal(18, 8)
  fxRateDate DateTime?

  occurredAt DateTime  @default(now())
  dueDate    DateTime?

  /// Set when this row was materialised from a RecurringExpense. `periodKey`
  /// ("2026-09") makes generation idempotent — running it twice cannot create
  /// September's rent twice.
  recurringId String?
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  periodKey   String?

  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]

  @@unique([recurringId, periodKey])
  @@index([kind])
  @@index([occurredAt])
}

/// A standing cost. Defined once; the finance calendar materialises the next
/// twelve months of Expense + Payment rows from it, so future months are visible
/// in cash flow without anyone re-typing the rent every month.
model RecurringExpense {
  id    String      @id @default(cuid())
  title String
  kind  ExpenseKind @default(OTHER)

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)

  amount   Decimal @db.Decimal(18, 4)
  currency String  @default("TRY")

  frequency  RecurrenceFreq @default(MONTHLY)
  /// 1-28 only, so the same day exists in every month including February.
  dayOfMonth Int            @default(1)
  startsAt   DateTime
  endsAt     DateTime?
  active     Boolean        @default(true)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([active])
}

/// A tax or statutory obligation as a DIARY ENTRY.
///
/// Business OS deliberately has NO tax engine. It never applies legislation, and
/// never tells the owner what they owe — an accountant does that. What it does
/// is remember what was declared, when it is due, and whether it was paid, so
/// the obligation shows up in cash flow next to everything else.
model TaxRecord {
  id     String @id @default(cuid())
  kind   String
  period String

  amount   Decimal? @db.Decimal(18, 4)
  currency String   @default("TRY")

  dueDate DateTime
  status  TaxStatus @default(PLANNED)
  paidAt  DateTime?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@unique([kind, period])
  @@index([dueDate, status])
}

// ---------------------------------------------------------------------------
// Plumbing
// ---------------------------------------------------------------------------

/// Single-row Business OS configuration (id = "os"), mirroring RadarSetting and
/// LeadSetting. `fxRates` holds the manually-entered rate table used as the
/// DEFAULT when a document is created; once saved, a document keeps its own rate.
///
/// The `company*` fields below are the legal entity that ISSUES trade documents
/// (quotation/proforma/invoice/packing list) — deliberately separate from the
/// unrelated `SiteSetting` model, which holds the public marketing site's
/// contact block. All nullable; the Trade Document System falls back to
/// compiled AYZENITH defaults (src/config/trade-documents.ts) until an admin
/// fills these in on Settings → Company Profile.
model OsSetting {
  id                 String    @id @default("os")
  baseCurrency       String    @default("TRY")
  defaultCountry     String    @default("TR")
  /// Off by default: a sale that would drive a location negative is refused
  /// rather than silently creating stock that does not exist.
  allowNegativeStock Boolean   @default(false)
  fxRates            Json? // { "EUR": 47.2, "USD": 40.1 }
  fxUpdatedAt        DateTime?

  companyLegalName   String?
  companyTradingName String?
  companyAddress     String?
  companyCountry     String?
  companyCity        String?
  companyPostalCode  String?
  companyPhone       String?
  companyEmail       String?
  companyWebsite     String?
  companyTaxNumber   String?
  companyVatNumber   String?
  companyChamberReg  String?
  companyLogoUrl     String?

  defaultDocLanguage   TradeDocLanguage @default(EN)
  defaultDocFooterNote String?

  updatedAt DateTime @updatedAt
}

/// Per-year document counters (key = "PURCHASE-2026"), incremented inside the
/// same transaction that creates the document, so two documents can never share
/// a code.
model OsSequence {
  key   String @id
  value Int    @default(0)
}

/// The audit record of one Excel import: how many rows landed, how many failed,
/// and why — so the failed rows can be re-downloaded as a spreadsheet and fixed.
model OsImportBatch {
  id       String  @id @default(cuid())
  entity   String
  fileName String?

  totalRows   Int  @default(0)
  createdRows Int  @default(0)
  updatedRows Int  @default(0)
  failedRows  Int  @default(0)
  errors      Json @default("[]")

  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// =============================================================================
// AYZENITH TRADE DOCUMENT SYSTEM — V1
// =============================================================================
//
// Additive on top of Business OS V1. Nothing above this line is touched.
//
// Two kinds of data, kept apart on purpose (see docs/BUSINESS-OS-DEVIR.md and
// the Trade Document System brief):
//
//   BUSINESS DATA  — Sale / SaleLine / Party / Item / Payment. A document never
//   forks a copy of a price or quantity; it always reads the live Sale through
//   `saleId`. There is no "amount" field on TradeDocument to drift from it.
//
//   DOCUMENT DATA  — TradeDocument / TradeDocumentLine / CompanySignatory /
//   CompanyBankAccount. Buyer-facing text, layout choices, logistics metadata
//   (HS code, packages, weights) and which signatory/bank account to print.
//   None of it is read back into Sale.
//
// Versioning: re-generating a document never deletes the old one. The new row
// points `parentDocumentId` at the previous version and both keep `code`
// unique via the printed number staying the same string across versions
// (e.g. "PI-2026-0012") — `isLatest` marks which row is current. A CANCELLED
// or superseded version is kept, never deleted: that is the audit trail a
// customer revision needs.
// =============================================================================

enum TradeDocType {
  QUOTATION
  PROFORMA_INVOICE
  COMMERCIAL_INVOICE
  PACKING_LIST
}

enum TradeDocLanguage {
  TR
  EN
  DE
}

enum TradeDocStatus {
  DRAFT
  FINAL
  CANCELLED
}

/// A person authorised to sign outgoing trade documents. Title, department and
/// signature image are all editable — "CEO & Founder" today, "Managing
/// Director" tomorrow, without touching any past document (each document keeps
/// its own copy of the printed name/title, see `TradeDocument.signatoryName`).
model CompanySignatory {
  id         String  @id @default(cuid())
  firstName  String
  lastName   String?
  jobTitle   String?
  department String?
  email      String?
  phone      String?

  signatureUrl         String?
  signatureDisplayName String?

  active            Boolean        @default(true)
  isDefault         Boolean        @default(false)
  supportedDocTypes TradeDocType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents TradeDocument[]

  @@index([active])
}

/// One of possibly several bank accounts a document can quote — a EUR account
/// for European buyers, a USD account for others.
model CompanyBankAccount {
  id            String  @id @default(cuid())
  bankName      String
  accountHolder String
  iban          String?
  swift         String?
  currency      String
  country       String?

  active    Boolean @default(true)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents TradeDocument[]

  @@index([active])
}

/// One printed trade document. Reads its commercial content (customer, items,
/// prices, totals) live from `sale`/`sale.lines` at render time — this row only
/// carries what is specific to THIS piece of paper: language, layout choices,
/// buyer-facing notes, and which version of the truth it is.
model TradeDocument {
  id      String       @id @default(cuid())
  code    String // e.g. "PI-2026-0012" — stable across versions of the same document
  docType TradeDocType

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  language TradeDocLanguage @default(EN)
  /// Independent of `language` — a German-language document can quote USD.
  currency String
  status   TradeDocStatus   @default(DRAFT)

  version          Int             @default(1)
  isLatest         Boolean         @default(true)
  parentDocumentId String?
  parent           TradeDocument?  @relation("TradeDocumentVersions", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  versions         TradeDocument[] @relation("TradeDocumentVersions")

  issuedAt   DateTime  @default(now())
  validUntil DateTime?

  // --- Commercial terms (DOCUMENT OVERRIDE — never rewrites the Sale) -------
  incoterm              String?
  shippingMethod        String?
  countryOfOrigin       String?
  paymentTermsOverride  String?
  deliveryTermsOverride String?

  // --- Buyer-facing free text ------------------------------------------------
  customerNote String?
  paymentNote  String?
  deliveryNote String?
  specialTerms String?
  footerNote   String?

  // --- Ship-to override (packing lists / commercial invoices routinely ship
  // to a different address than the invoiced party) -------------------------
  shipToName    String?
  shipToAddress String?
  shipToCity    String?
  shipToPostal  String?
  shipToCountry String?

  // --- Layout: which optional sections are visible on THIS document --------
  showBankDetails   Boolean @default(true)
  showVat           Boolean @default(true)
  showHsCode        Boolean @default(false)
  showCountryOrigin Boolean @default(false)
  showSignature     Boolean @default(true)
  showShipping      Boolean @default(false)

  // --- Who signs it, printed as of THIS version (name/title copied at
  // generation time so a later title change never rewrites an old PDF) ------
  signatoryId    String?
  signatory      CompanySignatory? @relation(fields: [signatoryId], references: [id], onDelete: SetNull)
  signatoryName  String?
  signatoryTitle String?

  bankAccountId String?
  bankAccount   CompanyBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines TradeDocumentLine[]

  @@index([saleId])
  @@index([docType])
  @@index([status])
  @@index([isLatest])
  @@index([code])
}

/// Per-line logistics/customs metadata that has no home on `SaleLine` (HS code,
/// country of origin, package count, weights) — keyed to the SaleLine it
/// describes so quantity/price/description always come from the one source.
model TradeDocumentLine {
  id         String        @id @default(cuid())
  documentId String
  document   TradeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  saleLineId String
  saleLine   SaleLine      @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  sortOrder  Int           @default(0)

  hsCode          String?
  countryOfOrigin String?
  packages        Int?
  netWeight       Decimal? @db.Decimal(18, 3)
  grossWeight     Decimal? @db.Decimal(18, 3)
  dimensions      String?

  @@unique([documentId, saleLineId])
  @@index([documentId])
}

// ============================================================================
// LOGISTICS INTELLIGENCE — v1 (additive, sits beside RADAR as an extra layer
// on its "Giriş Kolaylığı" criterion). NOT wired to any UI/action yet — schema
// only, drafted 2026-08-23, staged for review before a migration touches the
// live database. See project memory for the full architecture discussion.
//
// Chain (each stage is a distinct table, never overwrites the previous one):
//   RAW → NORMALIZED → VALIDATION → BENCHMARK → ESTIMATE → ACTUAL → CALIBRATION
//
// Core honesty rules, same doctrine as RadarSnapshot/AnalysisResult:
//   - A raw observation is never edited, only validated (flagged, not deleted).
//   - A price-per-kg coefficient is NEVER stored standalone and reapplied to a
//     different weight — every normalized observation keeps its OWN absolute
//     price and its OWN chargeable weight; a benchmark only ever groups
//     observations that already share a profile bucket.
//   - `LogisticsEstimate` is immutable once created (mirrors RadarSnapshot):
//     a re-query creates a new row, it never rewrites an old one.
//   - No band is generated below INSUFFICIENT estimateability — the gate is
//     checked BEFORE producing a number, not after.
// ============================================================================

enum LogisticsSourceType {
  OFFICIAL_INDEX       // EU weekly fuel bulletin, CNR, official toll tariffs
  COMMERCIAL_BENCHMARK // Upply/Ti/IRU quarterly report (entered manually)
}

enum EvidenceLevel {
  DIRECT_LANE          // same origin+dest+mode+profile, ≥2 observations
  NEARBY_LANE          // same country pair, similar city/route
  COUNTRY_CORRIDOR      // e.g. TR→DE, any city within the corridor
  REGIONAL_INDEX_ONLY  // only an index movement applied to an existing corridor base — NEVER standalone
  NONE
}

enum EstimateabilityBand {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT
}

enum TransportMode {
  ROAD // sea/air/rail deferred — no unused enum surface until a real need exists
}

enum ShipmentType {
  LTL
  FTL
}

enum CorridorType {
  DOMESTIC_EU
  TR_EU_CROSS_BORDER
}

/// How a NormalizedObservation's shipment profile was actually determined.
/// `MISSING` is the honest state for an absent field — never a silently
/// assumed default that could later be mistaken for real data.
enum NormalizationMethod {
  AS_REPORTED
  VOLUMETRIC_COMPUTED
  MISSING
}

/// The statistical method used to flag (never delete) an outlier observation.
enum ValidationMethod {
  MAD_3X // median absolute deviation, >3x flagged — simple, explainable, no ML
}

/// How a Benchmark's central value was computed from its member observations.
enum BenchmarkMethod {
  MEDIAN
  WEIGHTED_MEDIAN // weighted by sourceQuality × observationQuality per member
}

/// Source registry — SourceQuality lives here, changes rarely (admin-curated).
/// Deliberately separate from ObservationQuality (computed per-row, see
/// LogisticsNormalizedObservation) — a highly authoritative source can still
/// contribute a stale, low-quality individual observation.
model LogisticsSource {
  id                     String              @id @default(cuid())
  name                   String
  sourceType             LogisticsSourceType
  authorityScore         Int // 0-100, curated
  transparencyScore      Int
  coverageScore          Int
  historicalDepthMonths  Int?
  updateFrequency        String // "weekly" | "quarterly" | ...
  lastFetchedAt          DateTime?
  url                    String?

  rawObservations LogisticsRawObservation[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Lazy-created: only exists once a real query or observation touches it — the
/// city×city matrix is never pre-seeded, so lane count grows with real demand,
/// not with a combinatorial explosion of every possible pair.
model LogisticsLane {
  id            String        @id @default(cuid())
  originCity    String
  originCountry String // ISO alpha-2
  destCity      String
  destCountry   String
  mode          TransportMode @default(ROAD)
  corridorType  CorridorType

  distanceKm       Float?
  borderCrossings  Json     @default("[]")
  // Placeholder only — toll varies by vehicle class, exact route and period,
  // so a single static number on the lane is NOT trustworthy on its own.
  // `tollLastUpdatedAt` exists so a stale value can be flagged; a proper
  // `LaneTollSnapshot` (time-boxed, vehicle-class-aware) is the post-MVP fix.
  tollExposureEur    Decimal?  @db.Decimal(10, 2)
  tollLastUpdatedAt  DateTime?
  lastCalibratedAt   DateTime?

  rawObservations LogisticsRawObservation[]
  benchmarks      LogisticsBenchmark[]
  estimates       LogisticsEstimate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([originCity, originCountry, destCity, destCountry, mode])
}

/// Immutable — exactly what the source said, verbatim. `rawPayload` keeps the
/// full original response so a citation can always be audited back to source.
model LogisticsRawObservation {
  id       String          @id @default(cuid())
  sourceId String
  source   LogisticsSource @relation(fields: [sourceId], references: [id])
  laneId   String?
  lane     LogisticsLane?  @relation(fields: [laneId], references: [id])

  rawShipmentDescription String? // the source's own free text, untouched
  rawPrice               Decimal @db.Decimal(10, 2)
  rawCurrency            String
  observedAt             DateTime // when the price was actually valid
  capturedAt             DateTime @default(now()) // when WE saw it
  rawPayload             Json // the source's full original response

  normalized LogisticsNormalizedObservation?
  createdAt  DateTime @default(now())

  @@index([laneId])
  @@index([sourceId])
}

/// Profile-shaped and comparable — but NEVER a portable rate. `priceEur` and
/// `chargeableWeightKg` always travel together as one observation's own pair;
/// there is no field here that could be multiplied onto a different weight.
model LogisticsNormalizedObservation {
  id               String                  @id @default(cuid())
  rawObservationId String                  @unique
  rawObservation   LogisticsRawObservation @relation(fields: [rawObservationId], references: [id])

  chargeableWeightKg Float // max(actual weight, L*W*H(cm)/3000)
  volumeM3           Float?
  palletCount        Int?
  shipmentType       ShipmentType?
  incoterm           String?
  tollIncluded       Boolean? // null = unknown, never coerced to false
  fuelIncluded       Boolean?

  priceEur Decimal @db.Decimal(10, 2) // this observation's own absolute price

  normalizationConfidence Int // 0-100 — drops as more fields were MISSING
  normalizationMethod     NormalizationMethod

  validation           LogisticsValidation?
  benchmarkMemberships LogisticsBenchmarkObservation[]
  createdAt            DateTime @default(now())
}

/// 1:1 with a normalized observation. Flags, never deletes or silently edits —
/// `validatedValue` defaults to `rawValue` and only diverges if a human
/// deliberately corrects a provable data-entry error, never an automated one.
model LogisticsValidation {
  id                      String                         @id @default(cuid())
  normalizedObservationId String                         @unique
  normalizedObservation   LogisticsNormalizedObservation @relation(fields: [normalizedObservationId], references: [id])

  rawValue         Decimal          @db.Decimal(10, 2) // echo, for audit
  validatedValue   Decimal          @db.Decimal(10, 2) // defaults to rawValue
  outlierFlag      Boolean          @default(false)
  outlierReason    String?
  validationMethod ValidationMethod @default(MAD_3X)

  createdAt DateTime @default(now())
}

/// Derived reference, never a raw fact — the median (or weighted median) of
/// observations sharing one profile bucket on one lane. `members` keeps the
/// join to every contributing observation so a benchmark can always be
/// unpacked back to the real prices it came from.
model LogisticsBenchmark {
  id     String        @id @default(cuid())
  laneId String
  lane   LogisticsLane @relation(fields: [laneId], references: [id])

  mode              TransportMode @default(ROAD)
  shipmentType      ShipmentType
  weightBucketMinKg Float
  weightBucketMaxKg Float

  calculationMethod BenchmarkMethod @default(MEDIAN)
  medianPriceEur    Decimal         @db.Decimal(10, 2)
  p25PriceEur       Decimal?        @db.Decimal(10, 2)
  p75PriceEur       Decimal?        @db.Decimal(10, 2)
  minPriceEur       Decimal?        @db.Decimal(10, 2)
  maxPriceEur       Decimal?        @db.Decimal(10, 2)
  sampleSize        Int
  freshnessScore    Int // 0-100

  members    LogisticsBenchmarkObservation[]
  estimates  LogisticsEstimate[]
  computedAt DateTime @default(now())

  @@index([laneId, mode, shipmentType])
}

/// Join table — which normalized observations make up one benchmark, and each
/// member's own weight in it (sourceQuality × observationQuality at the time
/// the benchmark was computed).
model LogisticsBenchmarkObservation {
  benchmarkId             String
  benchmark               LogisticsBenchmark             @relation(fields: [benchmarkId], references: [id])
  normalizedObservationId String
  normalizedObservation   LogisticsNormalizedObservation @relation(fields: [normalizedObservationId], references: [id])
  weight                  Float

  @@id([benchmarkId, normalizedObservationId])
}

/// Immutable — same principle as RadarSnapshot: a re-query creates a new row,
/// never rewrites an old one. Estimateability is judged BEFORE a band is
/// produced and frozen alongside it, since it is a judgement made at that
/// moment, not a standalone re-usable fact (hence no separate table for it).
model LogisticsEstimate {
  id          String              @id @default(cuid())
  laneId      String
  lane        LogisticsLane       @relation(fields: [laneId], references: [id])
  benchmarkId String?
  benchmark   LogisticsBenchmark? @relation(fields: [benchmarkId], references: [id])

  queryProfile Json // the query's own shipment profile (weight, volume, mode...)

  evidenceLevel           EvidenceLevel
  estimateability         EstimateabilityBand
  estimateabilityFactors  Json // { evidenceLevel, observationCount, avgObservationQuality, profileSimilarity, sourceDiversity }

  // How the band was actually produced — audit-critical, distinct from the
  // human-readable `citations` shown in the UI: this is what the BACKEND
  // needs to answer "what exact observations fed this number" even if a
  // benchmark's own membership changes later.
  estimateMethod       String // e.g. "benchmark_median" | "index_adjusted_corridor_base"
  sourceObservationIds Json   // string[] of LogisticsNormalizedObservation ids

  estimatedMinEur    Decimal? @db.Decimal(10, 2) // null ⇒ VERİ YETERSİZ
  estimatedMaxEur    Decimal? @db.Decimal(10, 2)
  insufficientReason String?

  citations Json // user-facing source chain shown in the UI

  actualCosts LogisticsActualCost[]
  createdAt   DateTime @default(now())

  @@index([laneId])
}

/// From Business OS's real CostLine data — compared against whatever estimate
/// existed (if any) for that lane/profile at the time. `estimateId` is
/// nullable AND non-unique on purpose: a real shipment might have had no
/// estimate at all, and nothing here forces a 1:1 relationship an estimate's
/// own definition (one query snapshot) doesn't actually guarantee.
model LogisticsActualCost {
  id         String              @id @default(cuid())
  estimateId String?
  estimate   LogisticsEstimate?  @relation(fields: [estimateId], references: [id])

  purchaseId             String? // Business OS Purchase.id — the real freight CostLine
  actualCostEur          Decimal  @db.Decimal(10, 2)
  actualDate             DateTime
  actualShipmentProfile  Json

  absoluteError        Decimal? @db.Decimal(10, 2)
  withinPredictionBand Boolean?

  createdAt DateTime @default(now())

  @@index([estimateId])
  @@index([purchaseId])
}

/// Periodic job output — MAE/MAPE/within-band-rate, computed PER lane+mode
/// (never a single global number, which would hide that one corridor is
/// well-calibrated while another isn't). Feeds back into SourceQuality and a
/// corridor's estimateability ceiling over time — a rule-based recalibration,
/// not a hidden model.
model LogisticsCalibrationRun {
  id     String        @id @default(cuid())
  laneId String
  mode   TransportMode @default(ROAD)

  sampleSize    Int
  // Nullable: undefined/unreliable below a minimum sample size, and MAPE is
  // undefined outright if any actual cost in the sample was ever zero.
  mae           Decimal? @db.Decimal(10, 2)
  mapePct       Float?
  withinBandPct Float?

  runAt DateTime @default(now())

  @@index([laneId, mode])
}
